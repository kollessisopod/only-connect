# Only Connect — copy this file to .env and change every password before exposing the app (.env is git-ignored).
# Published port of the whole app (monitor / wall / button / admin).
APP_PORT=80

# Postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=12346789
POSTGRES_DB=onlyconnect

# MinIO (S3-compatible bucket for images/audio). Password must be at least 8 characters.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=12346789
MINIO_BUCKET=media
# MinIO web console (optional, http://host:9001)
MINIO_CONSOLE_PORT=9001
# Interface the console is published on: 127.0.0.1 (default, reach it with `ssh -L 9001:127.0.0.1:9001 <vm>`) or 0.0.0.0 for everyone
MINIO_CONSOLE_BIND=127.0.0.1

# Game master login for /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12346789
# Secret used to sign admin session tokens
# Use 32+ random characters in production, e.g. `openssl rand -base64 32`
JWT_SECRET=12346789
