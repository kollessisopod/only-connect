# Only Connect — copy this file to .env and change every password before exposing the app (.env is git-ignored).
# Published port of the whole app (monitor / wall / button / admin).
APP_PORT=80

# Postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=12346789
POSTGRES_DB=onlyconnect

# MinIO (S3-compatible bucket for images/audio). Password must be at least 8 characters.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=12346789
MINIO_BUCKET=media
# MinIO web console (optional, http://host:9001)
MINIO_CONSOLE_PORT=9001
# Interface the console is published on: 127.0.0.1 (default, reach it with `ssh -L 9001:127.0.0.1:9001 <vm>`) or 0.0.0.0 for everyone
MINIO_CONSOLE_BIND=127.0.0.1

# Game master login for /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12346789
# Secret used to sign admin session tokens
# Use 32+ random characters in production, e.g. `openssl rand -base64 32`
JWT_SECRET=12346789

# ---------------------------------------------------------------------------------------------------------
# API drivers (Version 4, docs/DESKTOP.md §2). docker-compose.yml does not read these: the compose stack always
# runs Postgres (`pg`) + MinIO (`s3`) + nginx, and the Windows app (OnlyConnect.exe) sets them itself
# (pglite + fs + SERVE_CLIENT_DIR). They only matter when you start `node api/dist/server.js` by hand, e.g.
# scripts/standalone-e2e.sh. Shown with the compose defaults.
# ---------------------------------------------------------------------------------------------------------
# Database driver: `pg` (Postgres at DATABASE_URL) or `pglite` (embedded Postgres, files in PGLITE_DIR).
# Same SQL and migrations for both.
#DATABASE_DRIVER=pg
# Required with DATABASE_DRIVER=pg (compose builds it from the POSTGRES_* values above).
#DATABASE_URL=postgres://admin:12346789@db:5432/onlyconnect
# Required with DATABASE_DRIVER=pglite: a directory (created on boot), or `memory://` for tests only.
#PGLITE_DIR=./OnlyConnect-data/db
# Object storage driver: `s3` (MinIO or any S3 bucket, S3_* below) or `fs` (files under MEDIA_DIR).
#STORAGE_DRIVER=s3
# Required with STORAGE_DRIVER=s3 (compose fills them from the MINIO_* values above).
#S3_ENDPOINT=http://minio:9000
#S3_REGION=us-east-1
#S3_ACCESS_KEY=admin
#S3_SECRET_KEY=12346789
#S3_BUCKET=media
# Required with STORAGE_DRIVER=fs: directory for the media files (created on boot).
#MEDIA_DIR=./OnlyConnect-data/media
# When set, the API serves this built client directory as the single-page app itself (no nginx). Unset in
# compose, where nginx serves the client.
#SERVE_CLIENT_DIR=./client/dist
# Size cap for a pack bundle upload (.only-connect.zip, pack + media), in bytes. Default 512 MiB.
#MAX_IMPORT_BYTES=536870912
