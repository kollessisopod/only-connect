{
  "name": "@only-connect/desktop",
  "version": "4.0.0",
  "private": true,
  "description": "Only Connect without Docker: the game server and its control window in one portable Windows executable",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "start": "npm run build && electron .",
    "dist:win": "electron-builder --win portable --x64",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.9"
  },
  "devDependencies": {
    "@types/node": "22.8.6",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
